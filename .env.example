# ─────────────────────────────────────────────────────────────────────────────
# Project Flux — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Configuration ────────────────────────────────────────────────────────
# Required for OpenAI-backed AI engine.
OPENAI_API_KEY=sk-...

# Optional: override to use a local LLM server (Ollama, llama.cpp, LM Studio).
# Must expose an OpenAI-compatible /v1/chat/completions endpoint.
# OPENAI_BASE_URL=http://localhost:11434/v1

# LLM model identifier. Change to switch LLM providers without code changes.
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=0.2

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scilab ───────────────────────────────────────────────────────────────────
SCILAB_CMD=scilab-cli
SCILAB_TIMEOUT_S=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for development.
ALLOWED_ORIGINS=http://localhost:3000
