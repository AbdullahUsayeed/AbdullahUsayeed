# ─────────────────────────────────────────────────────────────────────────────
# System Link — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Free / Self-Hosted Tier ───────────────────────────────────────────────────
# Required when running System Link locally without a Pro license.
# Users with a Pro subscription do NOT need to set this — the cloud AI key
# is stored on the server side.
OPENAI_API_KEY=sk-...

# Optional: override to use a local LLM server (Ollama, llama.cpp, LM Studio).
# Must expose an OpenAI-compatible /v1/chat/completions endpoint.
# OPENAI_BASE_URL=http://localhost:11434/v1

# LLM model identifier. Change to switch LLM providers without code changes.
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=0.2

# ── Pro / Cloud Tier ──────────────────────────────────────────────────────────
# The owner's OpenAI API key used for validated Pro subscribers.
# NEVER expose this to end users. Only set this on the cloud server.
CLOUD_OPENAI_API_KEY=sk-...

# Gumroad product permalink — the slug from your product URL.
# Example: if the product URL is usayeed.gumroad.com/l/systemlink
# then set GUMROAD_PRODUCT_PERMALINK=systemlink
GUMROAD_PRODUCT_PERMALINK=

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scilab ───────────────────────────────────────────────────────────────────
SCILAB_CMD=scilab-cli
SCILAB_TIMEOUT_S=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for development.
ALLOWED_ORIGINS=http://localhost:3000
